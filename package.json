{
  "name": "visual-proof",
  "version": "0.8.0",
  "description": "Visual proof capture for agent tasks",
  "license": "MIT",
  "type": "module",
  "bin": {
    "visual-proof": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration test/corpus test/live",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "es-module-lexer": "^3.0.3",
    "picomatch": "^4.0.7",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "playwright": ">=1.57.0 <2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/ws": "^8.18.2",
    "playwright": "^1.64.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
